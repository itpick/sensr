  },
  {
    "id": "core-module-load",
    "enabled": true,
    "description": "A kernel module loads",
    "hook": "module",
    "target": "any",
    "action": "alert"
  },
  {
    "id": "core-bpf-load",
    "enabled": true,
    "description": "A process other than sensr-guard loads a BPF program or creates a BPF link",
    "hook": "bpf",
    "target": "any",
    "action": "alert"
  },
  {
    "id": "core-bpf-block-others",
    "enabled": false,
    "description": "Only sensr-guard may load BPF programs (suggested block)",
    "hook": "bpf",
    "target": "any",
    "action": "block"
  },
  {
    "id": "core-setuid-root",
    "enabled": true,
    "description": "A process gains uid 0 via setuid",
    "hook": "setuid",
    "target": { "uid": 0 },
    "action": "alert"
  }
