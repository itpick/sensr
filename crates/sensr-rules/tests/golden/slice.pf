# [prio: 200]
nat on eth0 inet from (eth1:network) to any port 500 -> (eth0:0) static-port # Automatic outbound rule
nat on eth0 inet from 127.0.0.0/8 to any port 500 -> (eth0:0) static-port # Automatic outbound rule
nat on eth0 inet from (eth1:network) to any -> (eth0:0) port 1024:65535 # Automatic outbound rule
nat on eth0 inet from 127.0.0.0/8 to any -> (eth0:0) port 1024:65535 # Automatic outbound rule
# [prio: 300]
no rdr on eth1 proto tcp from {any} to {(eth1)} port {22} # Anti-lockout; prevent redirects for protected ports to this interface address
no rdr on eth1 proto tcp from {any} to {(eth1)} port {80} # Anti-lockout; prevent redirects for protected ports to this interface address
no rdr on eth1 proto tcp from {any} to {(eth1)} port {443} # Anti-lockout; prevent redirects for protected ports to this interface address
# [prio: 600]
rdr on eth0 inet proto tcp from {any} to {(eth0)} port {443} -> 192.168.1.10 port 8443 # web server
nat on eth0 inet proto tcp from (eth0:network) to {192.168.1.10} port {8443} -> (eth0) port 1024:65535 # web server
rdr on eth1 inet proto tcp from {any} to {(eth0)} port {443} -> 192.168.1.10 port 8443 # web server
nat on eth1 inet proto tcp from (eth1:network) to {192.168.1.10} port {8443} -> (eth1) port 1024:65535 # web server
