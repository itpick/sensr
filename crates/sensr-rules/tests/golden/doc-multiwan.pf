# [prio: 200]
nat on igc0 inet from (igc1:network) to any port 500 -> (igc0:0) static-port # Automatic outbound rule
nat on igc0 inet from (igc1_vlan50:network) to any port 500 -> (igc0:0) static-port # Automatic outbound rule
nat on igc0 inet from 127.0.0.0/8 to any port 500 -> (igc0:0) static-port # Automatic outbound rule
nat on igc0 inet from (igc1:network) to any -> (igc0:0) port 1024:65535 # Automatic outbound rule
nat on igc0 inet from (igc1_vlan50:network) to any -> (igc0:0) port 1024:65535 # Automatic outbound rule
nat on igc0 inet from 127.0.0.0/8 to any -> (igc0:0) port 1024:65535 # Automatic outbound rule
nat on igc2 inet from (igc1:network) to any port 500 -> (igc2:0) static-port # Automatic outbound rule
nat on igc2 inet from (igc1_vlan50:network) to any port 500 -> (igc2:0) static-port # Automatic outbound rule
nat on igc2 inet from 127.0.0.0/8 to any port 500 -> (igc2:0) static-port # Automatic outbound rule
nat on igc2 inet from (igc1:network) to any -> (igc2:0) port 1024:65535 # Automatic outbound rule
nat on igc2 inet from (igc1_vlan50:network) to any -> (igc2:0) port 1024:65535 # Automatic outbound rule
nat on igc2 inet from 127.0.0.0/8 to any -> (igc2:0) port 1024:65535 # Automatic outbound rule
# [prio: 300]
no rdr on igc1 proto tcp from {any} to {(igc1)} port {80} # Anti-lockout; prevent redirects for protected ports to this interface address
no rdr on igc1 proto tcp from {any} to {(igc1)} port {8443} # Anti-lockout; prevent redirects for protected ports to this interface address
# [prio: 1]
# block in log quick inet6 from {any} to {any} label "92c36e7dd6e900eff9263c0c36eaa001" # Block all IPv6
block in log inet from {any} to {any} label "02f4bab031b57d1e30553ce08e0ec131" # Default deny / state violation rule
block in log inet6 from {any} to {any} label "02f4bab031b57d1e30553ce08e0ec131" # Default deny / state violation rule
pass in log quick inet6 proto ipv6-icmp from {any} to {any} icmp6-type {1,2,3,4,135,136} keep state label "e7c9d7283a8a1dd5793f4eb8a0b61539" # IPv6 RFC4890 requirements (ICMP)
pass out log quick inet6 proto ipv6-icmp from {(self)} to {fe80::/10} icmp6-type {128,129,133,134,135,136} keep state label "ad320c74571489f02bc7e13ed3b0faf1" # IPv6 RFC4890 requirements (ICMP)
pass out log quick inet6 proto ipv6-icmp from {(self)} to {ff02::/16} icmp6-type {128,129,133,134,135,136} keep state label "ad320c74571489f02bc7e13ed3b0faf1" # IPv6 RFC4890 requirements (ICMP)
pass in log quick inet6 proto ipv6-icmp from {fe80::/10} to {fe80::/10} icmp6-type {128,133,134,135,136} keep state label "2af1bbc2f5b570474a3e51da98cfea0d" # IPv6 RFC4890 requirements (ICMP)
pass in log quick inet6 proto ipv6-icmp from {fe80::/10} to {ff02::/16} icmp6-type {128,133,134,135,136} keep state label "2af1bbc2f5b570474a3e51da98cfea0d" # IPv6 RFC4890 requirements (ICMP)
pass in log quick inet6 proto ipv6-icmp from {ff02::/16} to {fe80::/10} icmp6-type {128,133,134,135,136} keep state label "51e2f531ca4ef477abcdc7c1ddc2e892" # IPv6 RFC4890 requirements (ICMP)
pass in log quick inet6 proto ipv6-icmp from {::} to {ff02::/16} icmp6-type {128,133,134,135,136} keep state label "640d734bf8867e36603953157d6945a5" # IPv6 RFC4890 requirements (ICMP)
block in log quick inet proto {tcp udp} from {any} port {0} to {any} label "aec9f3b63c93939f82538646dafef5b8" # block all targeting port 0
block in log quick inet6 proto {tcp udp} from {any} port {0} to {any} label "aec9f3b63c93939f82538646dafef5b8" # block all targeting port 0
block in log quick inet proto {tcp udp} from {any} to {any} port {0} label "6bf37cddd4ab4919991fd6799f2d087d" # block all targeting port 0
block in log quick inet6 proto {tcp udp} from {any} to {any} port {0} label "6bf37cddd4ab4919991fd6799f2d087d" # block all targeting port 0
