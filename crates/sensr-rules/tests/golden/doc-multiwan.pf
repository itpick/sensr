pass out log quick on igc0 proto udp from {any} port {68} to {any} port {67} label "5cf7ab808da1fcbca1ddb9ba9b46b669" # allow DHCP client on WAN_CABLE
pass in log quick on igc1 proto udp from {any} port {68} to {255.255.255.255} port {67} label "9a5ae4c7391ae65c139da21bf152637e" # allow access to DHCP server
pass in log quick on igc1 proto udp from {any} port {68} to {(self)} port {67} label "9a0443d67aca73b9884f8270d9e40e59" # allow access to DHCP server
