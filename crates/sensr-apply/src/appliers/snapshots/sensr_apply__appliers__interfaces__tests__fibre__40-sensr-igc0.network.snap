---
source: crates/sensr-apply/src/appliers/interfaces.rs
expression: f.contents
---
# Generated by sensr; do not edit.
[Match]
Name=igc0

[Link]
MACAddress=02:00:5e:10:20:30
RequiredForOnline=routable

[Network]
DHCP=yes
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[DHCPv4]
UseGateway=yes
UseRoutes=yes
# below networkd's default 1024: a WAN's lease wins over any other DHCP link
RouteMetric=100
UseDNS=no
DenyList=192.168.1.254
# type 1 + the link's current (spoofed) MAC, as dhclient sends it
ClientIdentifier=mac
UseMTU=no
VendorClassIdentifier=sensr-test
RequestOptions=1 3 6 121
SendOption=125:string:\x00\x00\x0d\xe9\x04\x01\x02\x03\x04

[DHCPv6]
UseDNS=no
WithoutRA=solicit
UseDelegatedPrefix=yes
PrefixDelegationHint=::/60
RapidCommit=yes
SendRelease=no
# the ISP keys the delegation on the DUID: keep it stable
DUIDType=link-layer
DUIDRawData=00:01:02:00:5e:10:20:30
