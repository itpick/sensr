--no-merge
--no-reload
--no-test
--enable-conf
/run/sensr/suricata/enable.conf
--disable-conf
/run/sensr/suricata/disable.conf
--drop-conf
/run/sensr/suricata/drop.conf
--modify-conf
/run/sensr/suricata/modify.conf
--etopen
