---
source: crates/sensr-apply/src/appliers/unbound.rs
expression: out
---
# Generated by sensr; do not edit.
server:
  # systemd runs unbound as its own (dynamic) user: no switch here
  username: ""
  directory: "/var/lib/unbound"
  chroot: ""
  pidfile: ""
  use-syslog: no
  logfile: ""
  port: 53
  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes
  hide-identity: yes
  hide-version: yes
  harden-referral-path: no
  module-config: "iterator"

  # Interfaces to bind to
  interface: 192.168.1.1
  interface: ::1

  # Access control
  access-control: 0.0.0.0/0 allow
  access-control: ::/0 allow
  access-control: 127.0.0.0/8 allow
  access-control: ::1/128 allow

  # Local zone and static records
  local-zone: "home.arpa." transparent
  local-zone: "lab.home.arpa." redirect
  local-data: "localhost A 127.0.0.1"
  local-data: "localhost AAAA ::1"
  local-data: "localhost.home.arpa A 127.0.0.1"
  local-data: "localhost.home.arpa AAAA ::1"
  local-data: "sensr.home.arpa A 192.168.1.1"
  local-data: "nas.home.arpa. IN A 192.168.1.10"
  local-data: "nas.home.arpa. IN AAAA fd00:1::10"
  local-data: "home.arpa. IN MX 10 mail.home.arpa."
  local-data: "lab.home.arpa. IN A 192.168.1.50"
  local-data: '_info.home.arpa. 300 IN TXT "sensr router"'
  local-data-ptr: "127.0.0.1 localhost"
  local-data-ptr: "::1 localhost"
  local-data-ptr: "192.168.1.1 sensr.home.arpa"
  local-data-ptr: "192.168.1.10 nas.home.arpa"
  local-data-ptr: "fd00:1::10 nas.home.arpa"
  domain-insecure: "corp.example"
  private-domain: "corp.example"

  # Registered DHCP leases
  include: "/var/lib/unbound/dhcp-leases.conf"
  tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

forward-zone:
  name: "corp.example."
  forward-addr: 10.8.0.53

forward-zone:
  name: "."
  forward-tls-upstream: yes
  forward-addr: 9.9.9.9@853#dns.quad9.net

remote-control:
  control-enable: yes
  control-interface: "/run/unbound/unbound.ctl"
  control-use-cert: no
