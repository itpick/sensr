---
source: crates/sensr-apply/src/appliers/suricata.rs
expression: "files[\"suricata.yaml\"]"
---
%YAML 1.1
---
# Generated by sensr; do not edit (Services > Intrusion Detection).
# Mode: detect. Tuning notes: docs/ids.md.
suricata-version: "8.0"

include:
  - "/run/sensr/suricata/vars.yaml"

default-log-dir: "/var/log/suricata"
default-rule-path: "/var/lib/suricata/rules"
rule-files:
  - "botcc.portgrouped.rules"
  - "botcc.rules"
  - "ciarmy.rules"
  - "compromised.rules"
  - "drop.rules"
  - "dshield.rules"
  - "emerging-attack_response.rules"
  - "emerging-coinminer.rules"
  - "emerging-current_events.rules"
  - "emerging-dns.rules"
  - "emerging-exploit.rules"
  - "emerging-exploit_kit.rules"
  - "emerging-malware.rules"
  - "emerging-mobile_malware.rules"
  - "emerging-phishing.rules"
  - "emerging-scan.rules"
  - "emerging-worm.rules"
  - "threatview_CS_c2.rules"
  - "/run/sensr/suricata/local.rules"
classification-file: "/var/lib/suricata/rules/classification.config"
reference-config-file: "/var/lib/suricata/rules/reference.config"
threshold-file: "/run/sensr/suricata/threshold.config"

stats:
  enabled: yes
  interval: 30

outputs:
  - eve-log:
      enabled: yes
      filetype: regular
      filename: eve.json
      community-id: true
      types:
        - alert:
            payload: false
            payload-printable: false
            packet: no
            metadata: yes
            tagged-packets: no
        - stats:
            totals: yes
            threads: no
            deltas: no

logging:
  default-log-level: notice
  outputs:
    - console:
        enabled: yes
    - file:
        enabled: no

unix-command:
  enabled: yes
  filename: "/run/suricata/suricata-command.socket"

af-packet:
  - interface: "igc0"
    threads: 3
    cluster-id: 99
    cluster-type: cluster_flow
    defrag: yes
    use-mmap: yes
    tpacket-v3: yes
    ring-size: 16384
    block-size: 1048576
    promisc: false
    checksum-checks: kernel

app-layer:
  protocols:
    telnet: { enabled: yes }
    rfb: { enabled: yes }
    mqtt: { enabled: yes }
    krb5: { enabled: yes }
    bittorrent-dht: { enabled: yes }
    snmp: { enabled: yes }
    ike: { enabled: yes }
    tls:
      enabled: yes
      detection-ports:
        dp: 443
    pgsql: { enabled: no }
    dcerpc: { enabled: yes }
    ftp: { enabled: yes }
    websocket: { enabled: yes }
    rdp: { enabled: yes }
    ssh: { enabled: yes }
    doh2: { enabled: yes }
    http2: { enabled: yes }
    smtp: { enabled: yes }
    imap: { enabled: detection-only }
    pop3: { enabled: yes }
    smb:
      enabled: yes
      detection-ports:
        dp: 139, 445
    nfs: { enabled: yes }
    tftp: { enabled: yes }
    dns:
      tcp: { enabled: yes }
      udp: { enabled: yes }
    http:
      enabled: yes
      libhtp:
        default-config:
          personality: IDS
          request-body-limit: 100 KiB
          response-body-limit: 100 KiB
    modbus: { enabled: no }
    dnp3: { enabled: no }
    enip: { enabled: no }
    ntp: { enabled: yes }
    quic: { enabled: yes }
    dhcp: { enabled: yes }
    sip: { enabled: yes }
    ldap: { tcp: { enabled: yes }, udp: { enabled: yes } }
    mdns: { enabled: yes }

# A memcap or parser failure lets the flow through instead of dropping it.
exception-policy: "ignore"

host-mode: "sniffer-only"
max-pending-packets: 2048

flow:
  memcap: 128 MiB
  hash-size: 65536
  prealloc: 10000
  emergency-recovery: 30

stream:
  memcap: 128 MiB
  checksum-validation: no
  inline: auto
  # connections already open when Suricata (re)starts are picked up instead
  # of having their packets dropped as stream_midstream
  midstream: true
  async-oneside: true
  reassembly:
    memcap: 256 MiB
    depth: 1 MiB
    toserver-chunk-size: 2560
    toclient-chunk-size: 2560
    randomize-chunk-size: yes

detect:
  profile: "medium"
  sgh-mpm-context: auto
  sgh-mpm-caching: yes
  sgh-mpm-caching-path: "/var/lib/suricata/cache/sgh"
  prefilter:
    default: mpm

mpm-algo: "auto"
spm-algo: auto

threading:
  set-cpu-affinity: yes
  cpu-affinity:
    management-cpu-set:
      cpu: [ 0 ]
    worker-cpu-set:
      cpu: [ "1-3" ]
      mode: exclusive
  detect-thread-ratio: 1.0

security:
  limit-noproc: true
