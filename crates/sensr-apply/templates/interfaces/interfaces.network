# Generated by sensr; do not edit.
[Match]
Name={{ item.name }}

[Link]
{% if item.mtu %}
MTUBytes={{ item.mtu }}
{% endif %}
{% if item.mac %}
MACAddress={{ item.mac }}
{% endif %}
RequiredForOnline={{ item.required_for_online }}

[Network]
DHCP={{ item.dhcp }}
IPv6AcceptRA={{ item.accept_ra }}
LinkLocalAddressing={{ item.link_local }}
{% if item.addresses %}
ConfigureWithoutCarrier=yes
{% endif %}
{% for a in item.addresses %}
Address={{ a }}
{% endfor %}
{% for g in item.gateways %}
Gateway={{ g }}
{% endfor %}
{% for v in item.vlans %}
VLAN={{ v }}
{% endfor %}
{% if item.track %}
DHCPPrefixDelegation=yes
IPv6SendRA=yes
{% endif %}
{% if item.dhcp4 %}

[DHCPv4]
UseGateway={{ item.dhcp4.use_gateway }}
UseRoutes={{ item.dhcp4.use_gateway }}
UseDNS=no
{% if item.dhcp4.hostname %}
Hostname={{ item.dhcp4.hostname }}
{% endif %}
{% if item.dhcp4.deny %}
DenyList={{ item.dhcp4.deny | join(" ") }}
{% endif %}
{% endif %}
{% if item.dhcp6 %}

[DHCPv6]
UseDNS=no
WithoutRA=solicit
{% if item.dhcp6.pd_len %}
PrefixDelegationHint=::/{{ item.dhcp6.pd_len }}
{% endif %}
{% if item.dhcp6.prefix_only %}
UseAddress=no
{% endif %}
{% endif %}
{% if item.track %}

[DHCPPrefixDelegation]
UplinkInterface={{ item.track.uplink }}
SubnetId={{ item.track.subnet_id }}
Announce=yes
{% endif %}
{% for r in item.policy_routes %}

[Route]
Gateway={{ r.gateway }}
Table={{ r.table }}
{% endfor %}
{% for r in item.policy_rules %}

[RoutingPolicyRule]
FirewallMark={{ r.mark }}
Table={{ r.table }}
Priority={{ r.priority }}
{% endfor %}
