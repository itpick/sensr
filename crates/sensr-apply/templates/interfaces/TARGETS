# One .network per assigned interface, one .netdev per VLAN, in /run/systemd/network/.
# 40- sorts before WireGuard's 50- files and after nothing NixOS ships.
# One .link per MAC-pinned card; 10- sorts before NixOS's own .link files so
# the pin wins (the engine also keeps a copy for the next boot's udev).
interfaces.link:10-sensr-[networkd.pins.%.name].link
interfaces.network:40-sensr-[networkd.links.%.name].network
interfaces.netdev:40-sensr-[networkd.vlans.%.name].netdev
