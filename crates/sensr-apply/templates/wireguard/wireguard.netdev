# Generated by sensr; do not edit.
[NetDev]
Name={{ item.name }}
Kind=wireguard
{% if item.mtu %}
MTUBytes={{ item.mtu }}
{% endif %}

[WireGuard]
PrivateKeyFile={{ item.private_key_file }}
{% if item.listen_port %}
ListenPort={{ item.listen_port }}
{% endif %}
RouteTable={{ item.route_table }}
{% for p in item.peers %}

[WireGuardPeer]
# {{ p.name }}
PublicKey={{ p.public_key }}
{% if p.preshared_key_file %}
PresharedKeyFile={{ p.preshared_key_file }}
{% endif %}
{% if p.endpoint %}
Endpoint={{ p.endpoint }}
{% endif %}
AllowedIPs={{ p.allowed_ips }}
{% if p.keepalive %}
PersistentKeepalive={{ p.keepalive }}
{% endif %}
{% endfor %}
