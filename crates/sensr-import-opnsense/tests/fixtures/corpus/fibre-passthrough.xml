<?xml version="1.0"?>
<opnsense>
  <system>
    <hostname>gw</hostname>
    <domain>home.example</domain>
    <dnsallowoverride>0</dnsallowoverride>
    <timezone>America/Chicago</timezone>
    <ipv6allow>1</ipv6allow>
    <dnsserver>2001:db8:53::53</dnsserver>
  </system>
  <interfaces>
    <wan>
      <if>igc0</if>
      <descr>FIBRE</descr>
      <enable>1</enable>
      <spoofmac>02:00:5e:10:20:30</spoofmac>
      <blockpriv>1</blockpriv>
      <blockbogons>1</blockbogons>
      <ipaddr>dhcp</ipaddr>
      <dhcphostname/>
      <alias-address/>
      <alias-subnet>32</alias-subnet>
      <dhcprejectfrom>192.168.1.254</dhcprejectfrom>
      <adv_dhcp_pt_timeout/>
      <adv_dhcp_pt_retry/>
      <adv_dhcp_pt_select_timeout/>
      <adv_dhcp_pt_reboot>5</adv_dhcp_pt_reboot>
      <adv_dhcp_pt_backoff_cutoff/>
      <adv_dhcp_pt_initial_interval/>
      <adv_dhcp_pt_values>SavedCfg</adv_dhcp_pt_values>
      <adv_dhcp_send_options>dhcp-client-identifier 1:2:0:5e:10:20:30, vendor-class-identifier "sensr-test", option-125 0:0:d:e9:4:1:2:3:4</adv_dhcp_send_options>
      <adv_dhcp_request_options>subnet-mask, routers, domain-name-servers, classless-routes</adv_dhcp_request_options>
      <adv_dhcp_required_options/>
      <adv_dhcp_option_modifiers/>
      <adv_dhcp_config_advanced>1</adv_dhcp_config_advanced>
      <adv_dhcp_config_file_override/>
      <adv_dhcp_config_file_override_path/>
      <ipaddrv6>dhcp6</ipaddrv6>
      <dhcp6-ia-pd-len>4</dhcp6-ia-pd-len>
      <dhcp6-ia-pd-send-hint>1</dhcp6-ia-pd-send-hint>
      <dhcp6_rapid_commit>1</dhcp6_rapid_commit>
    </wan>
    <lan>
      <if>igc1</if>
      <descr>LAN</descr>
      <enable>1</enable>
      <spoofmac/>
      <ipaddr>192.168.1.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>track6</ipaddrv6>
      <track6-interface>wan</track6-interface>
      <track6-prefix-id>0</track6-prefix-id>
    </lan>
    <opt1>
      <if>igc2</if>
      <descr>KIDS</descr>
      <enable>1</enable>
      <spoofmac/>
      <ipaddr>192.168.2.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>track6</ipaddrv6>
      <track6-interface>wan</track6-interface>
      <track6-prefix-id>1</track6-prefix-id>
    </opt1>
    <opt2>
      <if>igc3</if>
      <descr>LAB</descr>
      <enable>1</enable>
      <spoofmac/>
      <ipaddr>192.168.3.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>track6</ipaddrv6>
      <track6-interface>wan</track6-interface>
      <track6-prefix-id>10</track6-prefix-id>
    </opt2>
  </interfaces>
  <OPNsense>
    <Interfaces>
      <settings version="1.0.0">
        <disablechecksumoffloading>1</disablechecksumoffloading>
        <disablesegmentationoffloading>1</disablesegmentationoffloading>
        <disablelargereceiveoffloading>1</disablelargereceiveoffloading>
        <disablevlanhwfilter>2</disablevlanhwfilter>
        <disableipv6>0</disableipv6>
        <dhcp6_norelease>1</dhcp6_norelease>
        <dhcp6_debug>0</dhcp6_debug>
        <dhcp6_duid>0:3:0:1:02:00:5e:10:20:30</dhcp6_duid>
        <dhcp6_ratimeout>10</dhcp6_ratimeout>
      </settings>
    </Interfaces>
    <unboundplus version="1.0.10">
      <general>
        <enabled>1</enabled>
        <port>53</port>
        <active_interface/>
      </general>
    </unboundplus>
  </OPNsense>
</opnsense>
