flush ruleset

table inet filter {
  set iot_devices { type ipv4_addr; elements = { 192.168.1.20, 192.168.1.21, 192.168.1.22, 192.168.1.23, 192.168.1.24, 192.168.1.25, 192.168.1.26, 192.168.1.27 } }
  set kids_devices { type ipv4_addr; elements = { 192.168.1.40, 192.168.1.41, 192.168.1.42, 192.168.1.43 } }
  set admin_hosts { type ipv4_addr; elements = { 192.168.1.10, 192.168.1.11 } }
  set work_vpn_nets { type ipv4_addr; flags interval; elements = { 203.0.113.0/24, 198.51.100.0/24 } }
  set blocklist_v4 { type ipv4_addr; flags interval; elements = { 83.77.202.19, 211.48.187.233, 130.109.19.0/24, 108.35.123.0/24, 109.30.63.162, 161.31.203.0/24, 57.23.68.0/24, 37.60.157.175, 47.52.96.141, 183.32.30.128, 175.218.160.237, 117.185.153.0/24, 47.124.41.135, 88.229.147.19, 31.214.84.39, 126.215.20.20, 196.160.174.153, 128.233.35.242, 70.242.33.0/24, 180.158.228.0/24, 99.177.11.91, 44.59.252.0/24, 197.147.66.102, 101.254.41.0/24, 103.142.70.222, 141.142.212.175, 98.118.77.0/24, 39.118.119.0/24, 213.93.134.0/24, 38.214.189.82, 33.27.233.200, 175.200.203.27, 124.205.31.0/24, 54.225.83.0/24, 154.26.52.0/24, 39.51.186.19, 54.192.76.245, 89.186.242.0/24, 218.249.238.80, 22.73.52.190, 68.245.82.53, 136.185.75.235, 7.152.46.67, 133.187.85.58, 137.168.114.202, 195.99.122.190, 206.116.102.92, 188.14.14.121, 67.99.176.240, 186.178.186.0/24, 27.116.240.0/24, 53.247.0.168, 89.43.61.201, 183.102.244.112, 163.170.44.249, 185.202.237.243, 22.81.87.8, 39.238.74.153, 122.179.79.34, 6.7.52.240, 36.222.99.55, 8.128.108.0/24, 62.166.132.214, 34.31.181.170, 150.215.66.135, 131.9.225.156, 2.76.88.0/24, 159.61.31.133, 136.247.54.15, 64.97.141.0/24, 26.231.14.234, 17.226.166.130, 156.102.141.137, 207.244.126.225, 67.103.229.0/24, 32.200.226.172, 62.219.37.0/24, 78.62.79.165, 170.187.73.0/24, 36.239.112.25, 102.249.83.214, 58.82.220.104, 87.215.100.24, 185.187.9.118, 113.9.196.160, 76.32.57.202, 59.53.43.0/24, 11.92.138.210, 109.132.207.0/24, 132.253.167.0/24, 15.93.217.69, 5.45.133.0/24, 220.113.34.0/24, 32.232.5.142, 107.137.66.0/24, 182.122.56.68, 13.92.103.161, 79.105.148.173, 46.138.177.65, 4.9.97.63, 115.54.221.140, 214.201.157.252, 59.175.101.181, 187.71.207.252, 14.66.7.0/24, 190.130.220.0/24, 22.195.144.178, 76.23.235.0/24, 69.228.1.0/24, 85.165.125.0/24, 80.111.182.0/24, 86.195.42.129, 168.102.127.2, 24.135.45.0/24, 151.21.201.0/24, 78.119.43.136, 219.79.199.185, 39.145.74.0/24, 214.219.71.193, 130.8.117.0/24, 11.68.184.97, 214.231.25.161, 137.125.250.0/24, 117.35.47.17, 191.242.129.217, 68.120.105.0/24, 167.235.252.20, 123.147.23.165, 51.39.75.167, 191.155.68.0/24, 16.248.137.26, 178.111.250.0/24, 133.146.237.197, 31.102.159.240, 122.8.148.210, 130.230.137.235, 54.38.46.0/24, 135.134.184.0/24, 210.143.57.60, 128.248.201.0/24, 1.251.230.187, 37.213.176.31, 216.169.0.87, 215.203.61.51, 183.6.148.0/24, 17.201.199.151, 20.184.219.219, 13.143.52.0/24, 170.146.76.0/24, 69.223.161.0/24, 96.219.14.162, 103.104.41.0/24, 188.210.230.36, 165.146.248.0/24, 141.65.87.88, 73.152.130.250, 168.133.207.78, 124.201.61.0/24, 42.38.106.208, 128.112.231.195, 116.218.71.63, 24.89.175.82, 62.188.132.52, 6.211.196.135, 54.192.138.16, 128.142.184.0/24, 129.110.47.0/24, 64.196.204.111, 80.11.65.0/24, 182.242.250.0/24, 101.239.229.0/24, 28.114.79.0/24, 175.55.234.0/24, 199.20.0.60, 146.19.155.161, 65.223.57.0/24, 77.98.198.0/24, 154.0.5.118, 72.161.124.61, 141.126.14.181, 167.157.28.0/24, 128.215.41.0/24, 171.217.189.0/24, 9.173.215.102, 51.3.149.130, 18.105.253.80, 197.99.118.68, 195.151.55.127, 157.95.114.234, 171.28.74.14, 55.12.72.182, 16.94.201.183, 81.57.40.85, 49.94.239.0/24, 171.193.191.114, 44.55.1.0/24, 21.179.215.32, 144.106.194.211, 80.221.44.0/24, 122.100.190.115 } }
  set web_ports { type inet_service; elements = { 80, 443, 8080, 8443 } }
  set mail_ports { type inet_service; elements = { 25, 465, 587, 993, 995 } }
  flowtable ft { hook ingress priority 0; devices = { lan0, wan0 }; }
  chain input {
    type filter hook input priority filter; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    iifname "lan0" tcp dport { 22, 80, 443, 8080 } accept comment "anti-lockout"
    iifname "lan0" ip saddr 192.168.1.0/24 udp dport 53 counter accept comment "DNS to router"
    iifname "lan0" ip saddr 192.168.1.0/24 tcp dport 53 counter accept comment "DNS/TCP to router"
    iifname "lan0" ip saddr 192.168.1.0/24 udp dport 123 counter accept comment "NTP to router"
    iifname "lan0" ip saddr 192.168.1.0/24 udp dport 67 counter accept comment "DHCP"
    iifname "lan0" ip saddr @admin_hosts tcp dport 22 counter accept comment "admin SSH"
    iifname "lan0" ip saddr @admin_hosts tcp dport 443 counter accept comment "admin GUI"
    iifname "lan0" ip saddr 192.168.1.0/24 ip protocol icmp counter accept comment "ping router"
    iifname "wan0" ip protocol icmp counter accept comment "WAN ping"
    iifname "wan0" tcp dport 22 counter drop comment "WAN SSH"
    iifname "wan0" tcp dport 443 counter drop comment "WAN GUI"
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    meta l4proto { tcp, udp } flow add @ft
    ct state established,related accept
    ct state invalid drop
    iifname "lan0" ip saddr 192.168.1.0/24 ip daddr @blocklist_v4 counter drop comment "blocklist"
    iifname "lan0" ip saddr @iot_devices tcp dport @mail_ports counter drop comment "IoT no mail"
    iifname "lan0" ip saddr @iot_devices ip daddr @work_vpn_nets counter drop comment "IoT not to work"
    iifname "lan0" ip saddr @iot_devices tcp dport @web_ports counter accept comment "IoT web"
    iifname "lan0" ip saddr @iot_devices udp dport 123 counter accept comment "IoT NTP"
    iifname "lan0" ip saddr @iot_devices counter drop comment "IoT default deny"
    iifname "lan0" ip saddr @kids_devices tcp dport 6881-6889 counter drop comment "kids no bittorrent"
    iifname "lan0" ip saddr @kids_devices udp dport 3478-3480 counter drop comment "kids no STUN"
    iifname "lan0" ip saddr @kids_devices tcp dport @web_ports counter accept comment "kids web"
    iifname "lan0" ip saddr @kids_devices counter drop comment "kids default deny"
    iifname "lan0" ip saddr 192.168.1.0/24 tcp dport 445 counter drop comment "no SMB out"
    iifname "lan0" ip saddr 192.168.1.0/24 tcp dport 135-139 counter drop comment "no NetBIOS out"
    iifname "lan0" ip saddr 192.168.1.0/24 udp dport 137-138 counter drop comment "no NetBIOS/udp out"
    iifname "lan0" ip saddr 192.168.1.0/24 udp dport 1900 counter drop comment "no SSDP out"
    iifname "lan0" ip saddr 192.168.1.0/24 tcp dport 23 counter drop comment "no telnet out"
    iifname "lan0" ip saddr 192.168.1.60 ip daddr 198.18.0.0/24 udp dport 7000 counter accept comment "host exception 0"
    iifname "lan0" ip saddr 192.168.1.61 ip daddr 198.18.1.0/24 tcp dport 7001 counter drop comment "host exception 1"
    iifname "lan0" ip saddr 192.168.1.62 ip daddr 198.18.2.0/24 tcp dport 7002 counter accept comment "host exception 2"
    iifname "lan0" ip saddr 192.168.1.63 ip daddr 198.18.3.0/24 udp dport 7003 counter drop comment "host exception 3"
    iifname "lan0" ip saddr 192.168.1.64 ip daddr 198.18.4.0/24 tcp dport 7004 counter accept comment "host exception 4"
    iifname "lan0" ip saddr 192.168.1.65 ip daddr 198.18.5.0/24 tcp dport 7005 counter drop comment "host exception 5"
    iifname "lan0" ip saddr 192.168.1.66 ip daddr 198.18.6.0/24 udp dport 7006 counter accept comment "host exception 6"
    iifname "lan0" ip saddr 192.168.1.67 ip daddr 198.18.7.0/24 tcp dport 7007 counter drop comment "host exception 7"
    iifname "lan0" ip saddr 192.168.1.68 ip daddr 198.18.8.0/24 tcp dport 7008 counter accept comment "host exception 8"
    iifname "lan0" ip saddr 192.168.1.69 ip daddr 198.18.9.0/24 udp dport 7009 counter drop comment "host exception 9"
    iifname "lan0" ip saddr 192.168.1.70 ip daddr 198.18.10.0/24 tcp dport 7010 counter accept comment "host exception 10"
    iifname "lan0" ip saddr 192.168.1.71 ip daddr 198.18.11.0/24 tcp dport 7011 counter drop comment "host exception 11"
    iifname "lan0" ip saddr 192.168.1.72 ip daddr 198.18.12.0/24 udp dport 7012 counter accept comment "host exception 12"
    iifname "lan0" ip saddr 192.168.1.73 ip daddr 198.18.13.0/24 tcp dport 7013 counter drop comment "host exception 13"
    iifname "lan0" ip saddr 192.168.1.74 ip daddr 198.18.14.0/24 tcp dport 7014 counter accept comment "host exception 14"
    iifname "lan0" ip saddr 192.168.1.75 ip daddr 198.18.15.0/24 udp dport 7015 counter drop comment "host exception 15"
    iifname "lan0" ip saddr 192.168.1.76 ip daddr 198.18.16.0/24 tcp dport 7016 counter accept comment "host exception 16"
    iifname "lan0" ip saddr 192.168.1.77 ip daddr 198.18.17.0/24 tcp dport 7017 counter drop comment "host exception 17"
    iifname "lan0" ip saddr 192.168.1.78 ip daddr 198.18.18.0/24 udp dport 7018 counter accept comment "host exception 18"
    iifname "lan0" ip saddr 192.168.1.79 ip daddr 198.18.19.0/24 tcp dport 7019 counter drop comment "host exception 19"
    iifname "lan0" ip saddr 192.168.1.80 ip daddr 198.18.20.0/24 tcp dport 7020 counter accept comment "host exception 20"
    iifname "lan0" ip saddr 192.168.1.81 ip daddr 198.18.21.0/24 udp dport 7021 counter drop comment "host exception 21"
    iifname "lan0" ip saddr 192.168.1.82 ip daddr 198.18.22.0/24 tcp dport 7022 counter accept comment "host exception 22"
    iifname "lan0" ip saddr 192.168.1.0/24 counter accept comment "LAN to any"
    iifname "wan0" ip saddr @blocklist_v4 counter drop comment "WAN blocklist"
  }
  chain output { type filter hook output priority filter; policy accept; }
}
table ip nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "wan0" ip saddr 192.168.1.0/24 masquerade
  }
}
